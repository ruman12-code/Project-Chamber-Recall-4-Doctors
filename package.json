{
  "name": "chamber-recall",
  "version": "0.1.0",
  "private": true,
  "description": "Offline patient-history system for a private doctor's chamber.",
  "main": "out/src/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-assets.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "npm run build:main && node --test out/tests/*.test.js",
    "seed": "npm run build:main && node out/src/main/seed/cli.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}

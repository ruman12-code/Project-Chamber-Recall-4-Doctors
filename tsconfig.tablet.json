{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/tablet/**/*", "src/shared/**/*", "src/main/intake/flow.ts", "src/main/redflags/evaluate.ts", "src/main/redflags/types.ts", "src/main/rules/**/*"]
}
